{
  "name": "503073-final-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p apps/api/tsconfig.build.json",
    "start": "node build/api/index.js",
    "test": "tsx --tsconfig apps/web/tsconfig.json --test --test-concurrency=1 apps/api/test/auth.test.ts apps/api/test/notes.test.ts apps/web/test/autosave.test.ts apps/web/test/notes-ui.test.tsx apps/web/test/autosave-api.test.ts",
    "test:web": "tsx --tsconfig apps/web/tsconfig.json --test --test-concurrency=1 apps/web/test/autosave.test.ts apps/web/test/notes-ui.test.tsx"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@gsap/react": "2.1.2",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "gsap": "3.15.0",
    "helmet": "8.3.0",
    "lucide-react": "1.61.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "jsdom": "26.1.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
