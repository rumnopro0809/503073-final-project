# Copy to .env. Local development works without changes.
# Set NODE_ENV=production in the deployment environment, not for local builds.
HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
APP_URL=http://localhost:5173

# Empty: embedded PostgreSQL in .data/postgres (local development only).
# Set a PostgreSQL URL for a dedicated server or production.
DATABASE_URL=
DATA_DIR=.data/postgres

# file: writes .eml messages to .data/mail; smtp: delivers real email.
MAIL_TRANSPORT=file
MAIL_FROM=Ghi chu <no-reply@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Production requires DATABASE_URL, MAIL_TRANSPORT=smtp and HTTPS APP_URL.
# Set only behind a trusted reverse proxy.
TRUST_PROXY=false

# AI Summary: server-side key only. Empty key leaves AI disabled (HTTP 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
